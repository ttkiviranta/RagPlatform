{
  "info": {
    "_postman_id": "d44fc2ec-6a81-421a-b538-458e88c1b67c",
    "name": "RagPlatform",
    "description": "Manual Microsoft Entra ID PKCE authentication and Phase 10B two-user owner-isolation validation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication Requests",
      "item": [
        {
          "name": "Get User A Token",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Acquire a delegated token for User A with Postman's OAuth 2.0 Authorization Code (With PKCE) helper. Store it locally in userAToken, then send this request to validate protected API access.",
            "url": "{{baseUrl}}/api/documents",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userAToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get User B Token",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Acquire a delegated token for User B with Postman's OAuth 2.0 Authorization Code (With PKCE) helper. Store it locally in userBToken, then send this request to validate protected API access.",
            "url": "{{baseUrl}}/api/documents",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userBToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Document Requests",
      "item": [
        {
          "name": "Get Documents User A",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/documents",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userAToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User A can list accessible documents', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const documentId = pm.environment.get('documentId');",
                  "if (documentId) {",
                  "  const documents = pm.response.json();",
                  "  pm.test('User A can see the created document', function () {",
                  "    pm.expect(documents.some((document) => document.id === documentId)).to.eql(true);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get Documents User B",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/documents",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userBToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User B can list accessible documents', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const documents = pm.response.json();",
                  "pm.test('User B cannot see User A private document', function () {",
                  "  pm.expect(documents.some((document) => document.title === 'USER_A_PRIVATE_DOCUMENT')).to.eql(false);",
                  "});",
                  "const documentId = pm.environment.get('documentId');",
                  "if (documentId) {",
                  "  pm.test('User B cannot see User A document by ID', function () {",
                  "    pm.expect(documents.some((document) => document.id === documentId)).to.eql(false);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Create Document User A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"USER_A_PRIVATE_DOCUMENT\",\n  \"content\": \"Private content used to validate Phase 10B owner-based access.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/documents",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userAToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User A document was created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const document = pm.response.json();",
                  "  pm.environment.set('documentId', document.id);",
                  "  pm.test('Created document has the expected title', function () {",
                  "    pm.expect(document.title).to.eql('USER_A_PRIVATE_DOCUMENT');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
